# Copy is generated by `make setup` (scripts/setup_env.py) with random secrets. Placeholders only here.
POSTGRES_PASSWORD=change-me
RELAYOPS_DB_PORT=5440
RELAYOPS_API_PORT=8020
RELAYOPS_WEB_PORT=3020
RELAYOPS_DATABASE_URL=postgresql+psycopg://relayops:change-me@127.0.0.1:5440/relayops
RELAYOPS_SESSION_SECRET=change-me-to-a-long-random-value
RELAYOPS_WEB_ORIGIN=http://localhost:3020
RELAYOPS_API_ORIGIN=http://localhost:8020
# Secure cookies require HTTPS; local development uses plain HTTP on localhost.
RELAYOPS_COOKIE_SECURE=false
# `ollama` = real local inference. `fixture` = deterministic test provider (offline tests only).
RELAYOPS_LLM_PROVIDER=ollama
RELAYOPS_OLLAMA_BASE_URL=http://127.0.0.1:11434
RELAYOPS_CHAT_MODEL=qwen3:4b-instruct
RELAYOPS_EMBED_MODEL=embeddinggemma
RELAYOPS_EMBED_DIM=768
RELAYOPS_NUM_CTX=8192
RELAYOPS_MAX_OUTPUT_TOKENS=700
RELAYOPS_LLM_TIMEOUT_SECONDS=90
RELAYOPS_RUN_DEADLINE_SECONDS=420
RELAYOPS_MAX_INVESTIGATION_TURNS=4
RELAYOPS_MAX_TOOL_CALLS=6
# Synthetic world anchor: a fixed ISO timestamp (default 2026-11-06T12:00:00Z) or `now`.
RELAYOPS_WORLD_ANCHOR=
